<!DOCTYPE html>
<html>

<head>

    <title>Cadastro</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

    <div class="card">

        <h1>Cadastro</h1>

        <form action="/cadastro" method="POST">

